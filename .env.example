# Executar os comandos na raiz; banco relativo ao processo apps/api
DATABASE_PATH=../../data/nexo.sqlite
API_PORT=3001
API_HOST=127.0.0.1
API_ORIGIN=http://localhost:3001
WEB_ORIGIN=http://localhost:3000
# Necessária para respostas do agente; sem chave, login e console continuam acessíveis.
OPENAI_API_KEY=
LLM_MODEL=openai/gpt-4.1-mini
COOKIE_SECURE=false
# Falha controlada do legado (0 = desligada)
LEGACY_FAILURE_MS=0

# Portas publicadas no host pelo Docker; internas permanecem 3000/3001.
DOCKER_WEB_PORT=3000
DOCKER_API_PORT=3001

{
  "name": "@nexo/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "tsc",
    "start": "node --env-file-if-exists=../../.env dist/apps/api/src/server.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/*.test.ts",
    "seed": "tsx --env-file-if-exists=../../.env src/seed.ts"
  },
  "dependencies": {
    "fastify": "^5.12.7",
    "@fastify/cookie": "^11.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@mastra/core": "1.80.0",
    "zod": "^4.1.12",
    "@nexo/contracts": "*"
  }
}

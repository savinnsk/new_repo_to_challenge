{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": "../..",
    "rewriteRelativeImportExtensions": true
  },
  "include": [
    "src/**/*.ts",
    "../../packages/contracts/src/**/*.ts"
  ]
}
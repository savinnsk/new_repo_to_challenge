{
  "name": "nexo-assist",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w @nexo/api\" \"npm run dev -w @nexo/web\"",
    "build": "npm run build -w @nexo/api && npm run build -w @nexo/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint apps packages script",
    "test": "npm run test -w @nexo/api",
    "seed": "npm run seed -w @nexo/api",
    "test:e2e": "playwright test",
    "format": "prettier --write apps packages script tests playwright.config.ts eslint.config.js compose.dev.yaml compose.prod.yaml",
    "format:check": "prettier --check apps packages script tests playwright.config.ts eslint.config.js compose.dev.yaml compose.prod.yaml",
    "build:prod": "node script/build.mjs",
    "start:prod": "node script/start.mjs",
    "prod": "node script/prod.mjs",
    "docker:dev": "docker compose -f compose.dev.yaml up --build",
    "docker:dev:down": "docker compose -f compose.dev.yaml down",
    "docker:prod": "docker compose -f compose.prod.yaml up --build -d --wait",
    "docker:prod:down": "docker compose -f compose.prod.yaml down"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.19.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.0",
    "prettier": "^3.9.10",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
